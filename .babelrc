{
  "presets": ["@babel/preset-env", "@babel/preset-react", "@babel/preset-typescript"],
  "plugins": [
    ["import", { "libraryName": "antd", "libraryDirectory": "es", "style": true }],
    [
      "import",
      { "libraryName": "@ant-design/icons", "libraryDirectory": "es", "camel2DashComponentName": false },
      "ant-design-icons"
    ]
  ]
}
